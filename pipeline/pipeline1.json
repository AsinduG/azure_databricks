{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "extract audit table",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.audit_log where adf_run_id = '@{pipeline().parameters.pipeline_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "check_fail_count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(int(activity('check_fail_count').output.count),0),'FAILED','SUCCESS')} | MICHELIN\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "body_header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "\"body_header\""
				}
			},
			{
				"name": "body_footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "For any support please contact abc@gmail.com"
				}
			},
			{
				"name": "check_fail_count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT count(*) as count FROM ctrl.audit_log where adf_run_id = '@pipeline().parameters.pipeline_run_id'\nand status != 'SUCCESS' ",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "prepare logic app body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "body_header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "extract audit table",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "body_footer",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_app_body",
					"value": {
						"value": "{\n\"subject\": @{variables('subject')},\n\"email_recipients\": @{pipeline().globalParameters.email_reciepient},\n\"body_header\": @{variables('body_header')},\n\"body_footer\": @{variables('body_footer')},\n\"status_table\": @{activity('extract audit table').output.value}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Web1",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "prepare logic app body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logic_app_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_app_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"pipeline_run_id": {
				"type": "String"
			}
		},
		"variables": {
			"subject": {
				"type": "String"
			},
			"body_header": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			},
			"logic_app_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}